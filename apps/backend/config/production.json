{
  "rateLimit": {
    "global": {
      "max": 100,
      "timeWindow": 60000
    },
    "register": {
      "max": 3,
      "timeWindow": 600000
    },
    "login": {
      "max": 6,
      "timeWindow": 600000
    },
    "logout": {
      "max": 15,
      "timeWindow": 600000
    },
    "refreshToken": {
      "max": 25,
      "timeWindow": 900000
    },
    "profile": {
      "max": 50,
      "timeWindow": 60000
    },
    "passwordChange": {
      "max": 2,
      "timeWindow": 3600000
    },
    "accountDeletion": {
