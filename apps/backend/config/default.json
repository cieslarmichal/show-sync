{
  "database": {
    "url": null,
    "ssl": false,
    "pool": {
      "min": 2,
      "max": 10,
      "idleTimeoutMillis": 30000,
      "connectionTimeoutMillis": 10000,
      "maxLifetimeSeconds": 600,
      "keepAlive": true,
      "keepAliveInitialDelayMillis": 5000
    }
  },
  "cookie": {
    "secret": null
  },
  "frontendUrl": "http://localhost:5173",
  "hashSaltRounds": 12,
  "logLevel": "debug",
  "server": {
    "host": "0.0.0.0",
    "port": 5000
  },
  "rateLimit": {
    "global": {
      "max": 150,
      "timeWindow": 60000
    },
    "register": {
      "max": 3,
      "timeWindow": 600000
    },
    "login": {
      "max": 6,
      "timeWindow": 600000
    },
    "logout": {
      "max": 10,
      "timeWindow": 600000
    },
    "refreshToken": {
      "max": 30,
      "timeWindow": 900000
    },
    "profile": {
      "max": 60,
      "timeWindow": 60000
    },
    "passwordChange": {
      "max": 3,
      "timeWindow": 3600000
    },
    "oneTimeToken": {
      "max": 10,
      "timeWindow": 600000
    },
    "accountDeletion": {
      "max": 2,
      "timeWindow": 3600000
    },
    "recommendations": {
      "max": 5,
      "timeWindow": 60000
    }
  },
  "resend": {
    "apiKey": null,
    "fromEmail": "ShowSync <noreply@show-sync.com>",
    "emails": {
      "verifyAccount": {
        "pl": {
          "templateFile": "pl_verifyAccount.html",
          "subject": "Zweryfikuj swoje konto ShowSync"
        },
        "en": {
          "templateFile": "verifyAccount.html",
          "subject": "Verify your ShowSync account"
        }
      },
      "resetPassword": {
        "pl": {
          "templateFile": "pl_resetPassword.html",
          "subject": "Zresetuj swoje hasło do ShowSync"
        },
        "en": {
          "templateFile": "en_resetPassword.html",
          "subject": "Reset your ShowSync password"
        }
      }
    }
  },
  "token": {
    "access": {
      "secret": null,
      "expiresIn": 900
    },
    "refresh": {
      "secret": null,
      "expiresIn": 604800,
      "graceMs": 10000,
      "idempotencyMs": 3000
    },
    "accountVerification": {
      "expiresIn": 86400
    },
    "resetPassword": {
      "expiresIn": 3600
    }
  },
  "tmdb": {
    "apiKey": null,
    "baseUrl": "https://api.themoviedb.org/3"
  },
  "openRouter": {
    "apiKey": null,
    "baseUrl": "https://openrouter.ai/api/v1",
    "model": "openai/gpt-4o-mini",
    "temperature": 0.8,
    "maxTokens": 2500,
    "maxMessageLength": 100000,
    "maxRetries": 3,
    "retryDelayMs": 1000,
    "requestTimeoutMs": 30000,
    "maxRetryDelayMs": 30000
  },
  "recommendations": {
    "dailyRequests": 10
  },
  "watchroom": {
    "maxParticipants": 6
  },
  "emailVerification": {
    "enabled": true
  },
  "oauth": {
    "google": {
      "clientId": null,
      "clientSecret": null,
      "callbackUrl": "http://localhost:5000/auth/google/callback"
    }
  }
}
